meta {
  name: Login (User)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "aditi@acme.com",
    "password": "password123",
    "user_type": "user"
  }
}

docs {
  A user belongs to one client (Aditi -> Acme Corp) and only sees that client's tickets.
}

vars:post-response {
  token: res.body.token
}
