meta {
  name: Create Ticket
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/tickets
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "title": "Cannot access subscription settings",
    "description": "Getting a 403 Forbidden error on /subscription route.",
    "priority": "high"
  }
}

vars:post-response {
  ticketId: res.body.id
}
