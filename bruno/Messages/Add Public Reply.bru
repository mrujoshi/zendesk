meta {
  name: Add Public Reply
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/tickets/{{ticketId}}/messages
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "text": "We are investigating the permission cache and will update you within 30 minutes.",
    "visibility": "public"
  }
}
